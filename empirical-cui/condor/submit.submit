universe = vanilla

######## SETTINGS USED FOR INITIAL H=0,1,... INFERENCE
# NumHybs = $(Process)
# PQ = 1.0

######## SETTINGS USED FOR SUBSEQUENT ANALYSES TO ASSESS THE AFFECT OF PROPQUARTETS
NumHybs = 2
PQ = 0.7

log = ./logs/$(Cluster)_$(NumHybs).log
error = ./errors/$(Cluster)_$(NumHybs).err
output = ./outputs/$(Cluster)_$(NumHybs).out

############################################################################################################
executable = ./transfer-files/condor_empirical_driver.sh
arguments = $(NumHybs) $(PQ)
############################################################################################################

should_transfer_files = YES
transfer_input_files = \
    ./transfer-files/condor_empirical_driver.sh, \
    ./transfer-files/julia-1.9.3-linux-x86_64.tar.gz,   \
    ./transfer-files/script.jl, \
    ./transfer-files/snaq2-proj.tar.gz, \
    ../input/cui-neza.csv,  \
    ../input/cui-neza.tre,  \
    ../input/best0.tre,     \
    ../input/best1.tre,     \
    ../input/best2.tre,     \
    ../input/best3.tre,     \
    ../input/best4.tre,     \
    ../input/best5.tre

request_disk = 16GB
######## SETTING USED FOR INITIAL H=0,1,... INFERENCE
#request_cpus = 16
#request_memory = 128GB

######## SETTINGS USED FOR SUBSEQUENT ANALYSES TO ASSESS THE AFFECT OF PROPQUARTETS
request_cpus = 4
request_memory = 16GB

######## SETTING USED FOR INITIAL H=0,1,... INFERENCE
#queue 6

######## SETTINGS USED FOR SUBSEQUENT ANALYSES TO ASSESS THE AFFECT OF PROPQUARTETS
queue 1
